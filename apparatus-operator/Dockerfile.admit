# syntax=docker/dockerfile:1
# Image locale gold : binaire apparatus-admit + ORAS/Cosign host (pas de docker.sock).
# Contexte de build = racine du workspace Cargo.
FROM rust:1.89-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    clang \
    libclang-dev \
    nasm \
    perl \
    pkg-config \
    libssl-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src
COPY . .

ENV CARGO_TERM_COLOR=never
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=apparatus-admit-target-bookworm,target=/usr/src/target \
    cargo build --release -p apparatus-operator --bin apparatus-admit --features admit,controller \
    && cp /usr/src/target/release/apparatus-admit /tmp/apparatus-admit

# Cosign / ORAS pins alignés sur apparatus-operator/src/admit.rs (COSIGN_IMAGE / ORAS_IMAGE).
ARG COSIGN_VERSION=2.4.3
ARG ORAS_VERSION=1.2.2
RUN cd /tmp \
    && curl -fsSL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64" \
      -o cosign-linux-amd64 \
    && curl -fsSL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign_checksums.txt" \
      -o cosign_checksums.txt \
    && grep -E '  cosign-linux-amd64$' cosign_checksums.txt > cosign.sha \
    && test -s cosign.sha \
    && sha256sum -c cosign.sha \
    && mv cosign-linux-amd64 cosign \
    && curl -fsSL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_amd64.tar.gz" \
      -o "oras_${ORAS_VERSION}_linux_amd64.tar.gz" \
    && curl -fsSL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_checksums.txt" \
      -o oras_checksums.txt \
    && grep -E "  oras_${ORAS_VERSION}_linux_amd64.tar.gz$" oras_checksums.txt > oras.sha \
    && test -s oras.sha \
    && sha256sum -c oras.sha \
    && tar -xzf "oras_${ORAS_VERSION}_linux_amd64.tar.gz" -C /tmp oras \
    && chmod 0555 /tmp/cosign /tmp/oras

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/apparatus \
    && chown 65534:65534 /var/lib/apparatus

COPY --from=builder /tmp/apparatus-admit /usr/local/bin/apparatus-admit
COPY --from=builder /tmp/cosign /usr/local/bin/cosign
COPY --from=builder /tmp/oras /usr/local/bin/oras
RUN chmod 0555 /usr/local/bin/apparatus-admit /usr/local/bin/cosign /usr/local/bin/oras

USER 65534:65534
ENTRYPOINT ["/usr/local/bin/apparatus-admit"]
