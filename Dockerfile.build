# syntax=docker/dockerfile:1
# rustc 1.94 : Cargo.lock (aws-sdk/smithy) exige rustc >= 1.91.1.
# Même base que runtime/monolith/Dockerfile.
# Registry/git downloads may be cached; compiled Cargo outputs never are.
FROM rust:1.94-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    clang \
    libclang-dev \
    nasm \
    perl \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src

COPY . .

ENV CARGO_TERM_COLOR=never
# Outside the copied checkout and without a cache mount: every uncached build
# starts with an empty Linux target. Cargo's configured 24 jobs stay unchanged.
ENV CARGO_TARGET_DIR=/var/tmp/aiforall-cargo-target
ARG DELIVERY_PROFILE=workspace
ARG SOURCE_REVISION=unattested
ARG SDK_REVISION=unattested
ARG CARGO_PROFILE=release
# Bake supplies package/bin/feature arguments from targets.json. The default
# retains the legacy Compose whole-workspace build, including its controller.
ARG CARGO_BUILD_ARGS="--workspace --bins --features apparatus-operator/controller"
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --locked --profile "$CARGO_PROFILE" $CARGO_BUILD_ARGS \
    && install -d /opt/release \
    && find "$CARGO_TARGET_DIR/$CARGO_PROFILE" -maxdepth 1 -type f -perm /111 \
       -exec install -m 0755 -t /opt/release {} + \
    && printf '%s' "$DELIVERY_PROFILE" > /opt/release/delivery-profile \
    && printf '%s' "$SOURCE_REVISION" > /opt/release/source-revision \
    && printf '%s' "$SDK_REVISION" > /opt/release/sdk-revision

# Executables only, not the toolchain, source tree or Cargo dependencies.
FROM debian:bookworm-slim AS artifacts

WORKDIR /app

COPY --from=builder /opt/release /app/target/release
