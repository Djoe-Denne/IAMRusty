# syntax=docker/dockerfile:1
ARG BUILD_IMAGE=local/build-artifacts:latest
FROM ${BUILD_IMAGE} AS artifacts
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
ARG BINARY=sentinel-sync
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /app/config && chown -R 1000:1000 /app
COPY --from=artifacts --chown=1000:1000 /app/target/release/${BINARY} /app/worker
USER 1000:1000
ENTRYPOINT ["/app/worker"]
