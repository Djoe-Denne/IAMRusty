# syntax=docker/dockerfile:1
# Packaging only. The shared Linux build owns Cargo and its persistent target.
ARG BUILD_IMAGE=local/build-artifacts:latest
FROM ${BUILD_IMAGE} AS artifacts
FROM debian:bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=artifacts --chown=65534:65534 /app/target/release/ext-authz /app/ext-authz
USER 65534:65534
ENV PORT=8090
EXPOSE 8090
ENTRYPOINT ["/app/ext-authz"]
