# syntax=docker/dockerfile:1
ARG BUILD_IMAGE
ARG RUNTIME_IMAGE
FROM ${BUILD_IMAGE} AS artifacts
FROM ${RUNTIME_IMAGE} AS runtime
ARG RUNTIME_OPENSSL_PACKAGE
ARG SOURCE_REVISION
ARG SDK_REVISION
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      aiforall.dev.sdk-revision="${SDK_REVISION}"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl "${RUNTIME_OPENSSL_PACKAGE}" \
    && rm -rf /var/lib/apt/lists/*
COPY --from=artifacts --chown=1000:1000 /app/target/release/recovery/ /app/bin/
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/app/bin/oodhive-monolith"]
