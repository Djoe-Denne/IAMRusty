{
  "$schema": "https://opencode.ai/config.json",
  // AIForAll uses native OpenCode agents. The plugin policy is scoped to
  // this repository and does not change tool permissions or global settings.
  "default_agent": "build",
  "skills": [
    ".agents/skills",
    ".cursor/skills"
  ],
  "policies": [
    { "action": "plugin.use", "resource": "*/local-plugins/ensemble/*", "effect": "deny" },
    { "action": "plugin.use", "resource": "*\\local-plugins\\ensemble\\*", "effect": "deny" },
    { "action": "plugin.use", "resource": "@hueyexe/opencode-ensemble-local", "effect": "deny" },
    { "action": "plugin.use", "resource": "opencode-ensemble", "effect": "deny" }
  ],
  "mcp": {
    // Serena (proxy 1MCP) met ~90 s à démarrer.
    "timeout": {
      "startup": 150000
    },
    "servers": {
      "rust-code-mcp": {
        "type": "remote",
        "url": "http://127.0.0.1:3062/mcp?tags=rust-code-mcp",
        "oauth": false
      },
      "grepai": {
        "type": "remote",
        "url": "http://127.0.0.1:3062/mcp?tags=grepai",
        "oauth": false,
        "disabled": true
      },
      "serena": {
        "type": "remote",
        "url": "http://127.0.0.1:3062/mcp?tags=serena",
        "oauth": false
      },
      "qmd": { "type": "remote", "url": "http://127.0.0.1:3062/mcp?tags=qmd", "oauth": false },
      "kubernetes-mcp-server": {
        "type": "remote",
        "url": "http://127.0.0.1:3062/mcp?tags=kubernetes-mcp-server",
        "oauth": false
      },
      "ig-mcp-server": {
        "type": "local",
        "command": [
          "C:\\Users\\djden\\AppData\\Local\\Programs\\ig-mcp-server\\ig-mcp-server.exe",
          "-read-only",
          "-context",
          "kind-aiforall-local"
        ]
      }
    }
  }
}
